                      "color": "#F3EFE6"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The Kp index ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#F3EFE6"
                    }
                  },
                  {
                    "value": "measures how disturbed Earth's magnetic field is, from 0 to 9, in 3-hour steps. 0 to 3 is quiet, 4 is active, and 5 or more is a geomagnetic storm (NOAA G1 to G5): auroras reach lower latitudes and power grids and satellites feel it.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "12pt",
                      "color": "#A9B3C7"
                    }
                  }
                ]
              },
              {
